# TONE3000 build configuration. Copy to `.env` (gitignored) at the
# repo root; `.env.local` overrides it, and a variable set in the
# environment (CMake configure / script run) overrides all of them.
# The T3K_PUBLISHABLE_KEY block is read by CMake at configure time into the
# generated T3kConfig.h (plugin/ui/NativeUi.cmake); reconfigure after a
# change. The T3K_TOOLCHAIN / T3K_STAGE_DIR / T3K_SIGN* vars are read at
# run time by script/win-standalone.sh only.

# Required. Your TONE3000 publishable key (tone3000.com > Settings > API Keys;
# it looks like `t3k_pub_...`). It is the OAuth client_id the plugin uses to
# sign the user in. Without it, sign-in surfaces an error. Sign-in completes
# through a loopback redirect (http://localhost:<port>/), which is
# auto-allowed for publishable keys, so nothing else needs registering.
T3K_PUBLISHABLE_KEY=t3k_pub_your_key_here

# Optional. The TONE3000 API origin (no trailing slash). Defaults to
# production; set it to point at a staging deployment or a local server.
# T3K_API_DOMAIN=https://www.tone3000.com

# Optional. When "true", the plugin fetches ${T3K_API_DOMAIN}/api/v1/plugin/version
# once on startup and shows an "update available" notice if that version is
# newer than the running build. Off by default (forks).
# T3K_UPDATE_NOTICE=true

# --- Windows staging (script/win-standalone.sh only; not read by CMake) -----
# Staged buildkit dir (GCC/CMake/libraries). Default: $HOME/buildkit.
# The script prepends $T3K_TOOLCHAIN/{cmake-*/bin,hostbin,stage/usr/bin} to
# PATH and exports LD_LIBRARY_PATH for its stage/usr/lib when present;
# otherwise system cmake/gcc are used.
#T3K_TOOLCHAIN=/home/me/buildkit
# Where TONE3000-win-YYYYMMDD-HHMMSS/ dirs are created.
# Default: first /mnt/c/Users/*/Downloads (WSL), else $HOME/Downloads.
#T3K_STAGE_DIR=/mnt/c/Users/me/Downloads
# Authenticode signing (off unless T3K_SIGN=1). Certs/keys live OUTSIDE the
# repo and are never committed (see .gitignore); setup in the
# $T3K_SIGNING_DIR/README (default $HOME/signing) and
# docs/agents/windows-build.md. Local trust-chain tests:
#   bash script/signing/build-minica.sh   (mini-CA, no-password p12)
#   bash script/signing/make-demo-cert.sh (plain self-signed demo)
#T3K_SIGNING_DIR=$HOME/signing
#T3K_SIGN=0
# p12 basename inside the certs dir (no path, no .p12 suffix):
#T3K_SIGN_CERT=TONE3000
# p12 password (blank for passwordless p12s, e.g. minica):
#T3K_SIGN_PASS=
# RFC3161 timestamp URL (default http://timestamp.sectigo.com):
#T3K_SIGN_TS=http://timestamp.sectigo.com
# "0" to skip the post-sign chain check (default 1):
#T3K_SIGN_VERIFY=1
